# Backend Environment Variables

# Database
DB_HOST=MyDBWindowsIP
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=root
#DB_NAME=university_erp3
DB_NAME=university_erp_prod10

# Razorpay
RAZORPAY_KEY_ID=RazorPayKeyId
RAZORPAY_KEY_SECRET=RazorPayKeySecret

# Yardi
yardi_client_id=your_yardi_client_id
yardi_client_secret=your_yardi_client_secret

# JWT
JWT_SECRET=mySecret#

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password

# App
APP_URL=http://Server-IP:3000
APP_ENV=development
